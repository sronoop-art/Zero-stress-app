<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <application
        android:name=".ZeroStressApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ZeroStress"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".SplashScreenActivity"
            android:exported="true"
            android:theme="@style/Theme.ZeroStress"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".LoginActivity" android:theme="@style/Theme.ZeroStress" />

        <activity android:name=".RegisterActivity" android:theme="@style/Theme.ZeroStress" />
        <activity android:name=".AdminDashboardActivity" android:theme="@style/Theme.ZeroStress" />
        <activity android:name=".PlayerDashboardActivity" android:theme="@style/Theme.ZeroStress" />
        <activity android:name=".LeaderboardActivity" android:theme="@style/Theme.ZeroStress" />
        <activity android:name=".ChatActivity" android:theme="@style/Theme.ZeroStress"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".VoiceActivity" android:theme="@style/Theme.ZeroStress" />
        <activity android:name=".ProfileActivity" android:theme="@style/Theme.ZeroStress" />
        <activity android:name=".ScheduleActivity" android:theme="@style/Theme.ZeroStress" />
        <activity android:name=".FriendsActivity" android:theme="@style/Theme.ZeroStress" />
        <activity android:name=".AchievementsActivity" android:theme="@style/Theme.ZeroStress" />
        <activity android:name=".SeasonActivity" android:theme="@style/Theme.ZeroStress" />
        <activity android:name=".SubmitMatchActivity" android:theme="@style/Theme.ZeroStress" />
        <activity android:name=".AnnouncementsActivity" android:theme="@style/Theme.ZeroStress" />
        <activity android:name=".DailyInputActivity" android:theme="@style/Theme.ZeroStress" />
        <activity android:name=".PerformanceActivity" android:theme="@style/Theme.ZeroStress" />
        <activity android:name=".SettingsActivity" android:theme="@style/Theme.ZeroStress" />
        <activity android:name=".PlayerTitlesActivity" android:theme="@style/Theme.ZeroStress" />
        <activity android:name=".DailyChallengesActivity" android:theme="@style/Theme.ZeroStress" />
        <activity android:name=".BattlePassActivity" android:theme="@style/Theme.ZeroStress" />
        <activity android:name=".PerformanceGraphsActivity" android:theme="@style/Theme.ZeroStress" />
        <activity android:name=".DailyLoginRewardsActivity" android:theme="@style/Theme.ZeroStress" />
        <activity android:name=".SendNotificationActivity" android:theme="@style/Theme.ZeroStress" />
        <activity android:name=".ManageSeasonsActivity" android:theme="@style/Theme.ZeroStress" />
        <activity android:name=".ManageVoiceChannelsActivity" android:theme="@style/Theme.ZeroStress" />
        <activity android:name=".ViewAllPlayersStatsActivity" android:theme="@style/Theme.ZeroStress" />
        <activity android:name=".NotificationsActivity" android:theme="@style/Theme.ZeroStress" />

        <service
            android:name=".fcm.ZSFCMService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

    </application>
</manifest>
