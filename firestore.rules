rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Kill switch for App Check enforcement: flip the return value to true
    // and redeploy to lock every client write behind an attestation.
    // (Rules language has no variables - a function is the supported way
    // to hold this flag.)
    //
    // CURRENTLY OFF - do not flip back until BOTH are true:
    //   1. the Android app is registered in Firebase console > App Check with
    //      the Play Integrity provider, and
    //   2. the build that is actually installed attests successfully.
    // With the switch on and no attestation, request.app is null, so
    // hasAppCheck() returns false and EVERY client write is rejected: sending
    // a chat message, typing indicators, mentions and reports all fail with
    // "PERMISSION_DENIED: Missing or insufficient permissions." even though
    // reads keep working - which is exactly the lockout this flag exists for.
    // While it is off, writes only require a signed-in account plus the
    // senderId self-check, so treat it as an in-house/testing posture and put
    // the roster back behind an approved-player check when hardening again.
    function appcheckEnabled() {
      return false;
    }

    // ---------------------------------------------------------------------
    // Helpers
    // ---------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Reads the caller's role directly from their player doc.
    // Kept as get() (single read) — rules are evaluated once per request batch.
    function callerRole() {
      return get(/databases/$(database)/documents/players/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isSignedIn() && callerRole() == "admin";
    }

    // Moderators: trusted helpers between player and admin. They may clean
    // up chat but cannot manage players, seasons, or other admin data.
    function isModerator() {
      return isSignedIn() && callerRole() == "moderator";
    }

    function isStaff() {
      return isAdmin() || isModerator();
    }

    // ---------------------------------------------------------------------
    // App Check enforcement (production hardening).
    // Verified installs present a Play Integrity attestation; scripts hitting
    // Firestore directly with the public config do not.
    // KILL SWITCH: set appcheckEnabled() to false and redeploy if a device
    // without Play services is ever locked out.
    //
    // IMPORTANT: this is an ALLOW condition, so it must be TRUE for writes to
    // succeed. With enforcement OFF the check is bypassed (returns true); with
    // enforcement ON it demands a real attestation. An earlier version returned
    // appcheckEnabled() && request.app != null, which meant "enforcement off"
    // made hasAppCheck() false and denied every write - that is what caused
    // "Send failed: PERMISSION_DENIED" in Team Chat.
    // ---------------------------------------------------------------------
    function hasAppCheck() {
      return !appcheckEnabled() || request.app != null;
    }

    // ---------------------------------------------------------------------
    // players — profile / role / stats
    // Anyone signed in can read the roster (leaderboards, friend search).
    // Players may edit their own doc but NOT their role or approval state.
    // Only admins may promote/demote, approve, or ban players.
    // ---------------------------------------------------------------------
    match /players/{uid} {
      allow read: if isSignedIn();
      // New accounts always start as pending players - a client can never
      // create itself as admin (privilege escalation fix). role and status
      // are REQUIRED on create so a direct-API write cannot omit them and
      // inherit console defaults.
      allow create: if isSelf(uid)
                    && request.resource.data.role == 'player'
                    && request.resource.data.status == 'pending';
      // Admins may edit any player (approve, role, name, game role, stats).
      // Players may edit their own doc but can never change their own
      // role or approval status.
      allow update: if isAdmin()
                    || (isSelf(uid)
                        && !request.resource.data.diff(resource.data).affectedKeys()
                              .hasAny(['role', 'status']));
      // Admins moderate; players may delete their own account (Settings).
      allow delete: if isAdmin() || isSelf(uid);
    }

    // ---------------------------------------------------------------------
    // chat_messages / chat_typing — team chat
    // ---------------------------------------------------------------------
    match /chat_messages/{msgId} {
      allow read: if isSignedIn();
      // The sender can only write messages under their own uid. hasAppCheck()
      // additionally demands an attestation once App Check enforcement is
      // switched back on (see the kill switch above).
      allow create: if isSignedIn()
                    && hasAppCheck()
                    && request.resource.data.senderId == request.auth.uid;
      // No edits; admins and moderators can clean up.
      allow delete: if isStaff();
    }

    match /chat_typing/{uid} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && hasAppCheck();
    }

    // ---------------------------------------------------------------------
    // voice_channels — Discord-style voice (Agora)
    // ---------------------------------------------------------------------
    match /voice_channels/{channelId} {
      allow read, write: if isSignedIn();

      match /participants/{uid} {
        allow read, write: if isSignedIn();
      }

      match /call_chat/{msgId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
                      && request.resource.data.senderId == request.auth.uid;
        allow delete: if isStaff();
      }
    }

    // ---------------------------------------------------------------------
    // match_schedules / match_logs — schedule + submitted results
    // ---------------------------------------------------------------------
    match /match_schedules/{scheduleId} {
      allow read: if isSignedIn();
      allow create: if isAdmin();
      allow update, delete: if isAdmin();
    }

    match /match_logs/{logId} {
      allow read: if isSignedIn();
      // Player match submission is removed - stats are entered only by admins
      // (DailyInputActivity), which mirrors entries into match_logs.
      allow create: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // ---------------------------------------------------------------------
    // announcements / notifications — admin broadcasts
    // ---------------------------------------------------------------------
    match /announcements/{announcementId} {
      allow read: if isSignedIn();
      allow create: if isAdmin();
      allow update, delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      // A doc with "uid" belongs to one player; without it it is a broadcast
      // every signed-in member can read (the client also filters by uid).
      allow read: if isSignedIn()
                  && (resource.data.uid == null
                      || resource.data.uid == request.auth.uid);
      // Attribution: if a doc carries a senderId it must be the caller's own
      // uid, so a modified client cannot forge notifications that look like
      // they came from someone else (mentions/friend requests set senderId
      // to the sender; admin broadcasts carry no senderId and still pass).
      allow create: if isSignedIn() && hasAppCheck()
                    && (!('senderId' in request.resource.data)
                        || request.resource.data.senderId == request.auth.uid);
      // Recipients can manage their own copies (delete/clear); broadcasts
      // (no uid) stay admin-only so one player can't wipe everyone's feed.
      allow update, delete: if isAdmin()
                            || (resource.data.uid != null
                                && resource.data.uid == request.auth.uid);
    }

    // ---------------------------------------------------------------------
    // chat_reports — in-app abuse reports (Play Store UGC requirement).
    // Players file them from long-press on a chat message; only admins read.
    // ---------------------------------------------------------------------
    match /chat_reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isSignedIn()
                    && hasAppCheck()
                    && request.resource.data.reporterId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ---------------------------------------------------------------------
    // players/{uid}/blocked_users — personal block lists.
    // Only the owner of the list can read or change it.
    // ---------------------------------------------------------------------
    match /players/{uid}/blocked_users/{blockedId} {
      allow read, write: if isSelf(uid) && hasAppCheck();
    }

    // ---------------------------------------------------------------------
    // friend_requests / friendships — friend system
    // ---------------------------------------------------------------------
    match /friend_requests/{requestId} {
      allow read: if isSignedIn()
                  && (resource.data.from == request.auth.uid
                      || resource.data.to == request.auth.uid);
      allow create: if isSignedIn()
                    && request.resource.data.from == request.auth.uid;
      // Only the recipient accepts/rejects.
      allow update, delete: if isSignedIn()
                            && resource.data.to == request.auth.uid;
    }

    match /friendships/{friendshipId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // ---------------------------------------------------------------------
    // daily_stats — per-day performance input
    // ---------------------------------------------------------------------
    match /daily_stats/{statId} {
      allow read: if isSignedIn();
      // The app writes the subject's uid in "playerId" (signed-in player by
      // default, or a team-trust pick from the player selector). Admins may
      // also log for anyone.
      allow create, update: if isSignedIn()
                            && (request.resource.data.playerId == request.auth.uid
                                || isAdmin());
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------------------
    // player_achievements / player_titles — gamification
    // ---------------------------------------------------------------------
    match /player_achievements/{docId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /player_titles/{docId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------------------
    // seasons — admin-managed, with automatic rollover by Cloud Functions.
    // The Admin SDK bypasses rules, so no client write access is needed here.
    match /seasons/{seasonId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ---------------------------------------------------------------------
    // moderation_log — append-only audit trail of admin actions
    // (created client-side by admin screens; nobody can edit or delete)
    // ---------------------------------------------------------------------
    match /moderation_log/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
                    && request.resource.data.adminId == request.auth.uid;
      allow update, delete: if false;
    }

    // ---------------------------------------------------------------------
    // Default deny — anything not matched above is rejected.
    // ---------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
