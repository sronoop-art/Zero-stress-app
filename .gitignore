# Android / Gradle
.gradle/
build/
app/build/
local.properties
# Signing keystores must NEVER leave your machine - anyone holding the .jks
# can sign fake updates that install as this app.
*.jks

# IDE
.idea/
*.iml
.DS_Store

# Node / Firebase Functions
functions/node_modules/
functions/*.log
.firebase/

# Knock bridge (server/) - node_modules + local secrets
server/node_modules/
server/*.log

# Never commit environment files: they hold KNOCK_API_KEY and the Firebase
# service account. The workspace loads .env / .env.local automatically.
.env
.env.*
!.env.example

# Stray duplicate source folders at repo root (real sources live in app/src/main)
/java/
/res/

# google-services.json contains project identifiers; keep it local
app/google-services.json

# Old nested source snapshots. ZS3.1.zip is intentionally TRACKED despite
# appearing here: it is the phone build bundle (only app/ + gradle files) that
# the user downloads and opens in AndroidIDE, so it must stay current.
Zerostress.zip/
